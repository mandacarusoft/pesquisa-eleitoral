# Configuracao do banco MySQL (instalado na mesma maquina do sistema)
DB_HOST=192.168.1.128
DB_PORT=3306
DB_USER=pesquisa_user
DB_PASSWORD=senha_pesquisa
DB_NAME=pesquisa_eleitoral

# Pool de conexoes
DB_CONN_LIMIT=10

# JWT
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=12h

# Servidor
PORT=4000

# Se true, cria as tabelas e o seed inicial automaticamente ao subir o servidor
AUTO_MIGRATE=true
